{
  "name": "omoide",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p infra",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "deploy": "sst deploy --config infra/sst.config.ts --stage dev",
    "migrate": "./infra/scripts/migrate.sh dev"
  },
  "devDependencies": {
    "@pulumi/cloudflare": "6.19.0",
    "@types/node": "^24.3.0",
    "sst": "^4.17.1",
    "turbo": "^2.5.8",
    "typescript": "~6.0.3",
    "wrangler": "^4.125.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "unrs-resolver",
      "workerd"
    ]
  }
}
